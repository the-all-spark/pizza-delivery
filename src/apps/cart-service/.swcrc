{
  "jsc": {
    "parser": {
      "syntax": "typescript",
      "decorators": true,
      "dynamicImport": true
    },
    "transform": {
      "legacyDecorator": true,
      "decoratorMetadata": true
    },
    "target": "es2022",
    "baseUrl": "./",
    "paths": {
      "@shared/*": ["../../../src/shared/*"],
      "@apps/*": ["../../../src/apps/*"]
    }
  }
}
