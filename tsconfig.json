{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "types": ["node", "jest"],
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "paths": {
      "@shared/*": ["./src/shared/*"]
    }
  },
  "files": [],
  "references": [
    {
      "path": "./src/apps/api-gateway/tsconfig.app.json"
    },
    {
      "path": "./src/apps/auth-service/tsconfig.app.json"
    },
    {
      "path": "./src/apps/notification-service/tsconfig.app.json"
    },
    {
      "path": "./src/apps/logger-service/tsconfig.app.json"
    },
    {
      "path": "./src/apps/pizza-service/tsconfig.app.json"
    },
    {
      "path": "./src/apps/cart-service/tsconfig.app.json"
    },
    {
      "path": "./src/apps/ingredients-service/tsconfig.app.json"
    },
    {
      "path": "./src/apps/order-service/tsconfig.app.json"
    },
    {
      "path": "./src/apps/promo-code-service/tsconfig.app.json"
    }
  ]
}
