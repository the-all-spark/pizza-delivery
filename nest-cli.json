{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/pizza-delivery/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": "rspack",
    "tsConfigPath": "apps/pizza-delivery/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/pizza-delivery",
  "projects": {
    "api-gateway": {
      "type": "application",
      "root": "apps/api-gateway",
      "entryFile": "main",
      "sourceRoot": "apps/api-gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api-gateway/tsconfig.app.json"
      }
    },
    "auth-service": {
      "type": "application",
      "root": "apps/auth-service",
      "entryFile": "main",
      "sourceRoot": "apps/auth-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/auth-service/tsconfig.app.json"
      }
    },
    "logger-service": {
      "type": "application",
      "root": "apps/logger-service",
      "entryFile": "main",
      "sourceRoot": "apps/logger-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/logger-service/tsconfig.app.json"
      }
    },
    "notification-service": {
      "type": "application",
      "root": "apps/notification-service",
      "entryFile": "main",
      "sourceRoot": "apps/notification-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/notification-service/tsconfig.app.json"
      }
    },
    "pizza-delivery": {
      "type": "application",
      "root": "apps/pizza-delivery",
      "entryFile": "main",
      "sourceRoot": "apps/pizza-delivery/src",
      "compilerOptions": {
        "tsConfigPath": "apps/pizza-delivery/tsconfig.app.json"
      }
    },
    "pizza-service": {
      "type": "application",
      "root": "apps/pizza-service",
      "entryFile": "main",
      "sourceRoot": "apps/pizza-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/pizza-service/tsconfig.app.json"
      }
    }
  }
}