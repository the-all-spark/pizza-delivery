{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src", 
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": "rspack"
  },
  "monorepo": true,
  "root": "",
  "projects": {
    "api-gateway": {
      "type": "application",
      "root": "src/apps/api-gateway",
      "entryFile": "main",
      "sourceRoot": "src/apps/api-gateway/src",
      "compilerOptions": {
        "tsConfigPath": "src/apps/api-gateway/tsconfig.app.json",
        "outDir": "dist/src/apps/api-gateway"
      }
    },
    "auth-service": {
      "type": "application",
      "root": "src/apps/auth-service",
      "entryFile": "main",
      "sourceRoot": "src/apps/auth-service/src",
      "compilerOptions": {
        "tsConfigPath": "src/apps/auth-service/tsconfig.app.json",
        "outDir": "dist/src/apps/auth-service"
      }
    },
    "pizza-service": {
      "type": "application",
      "root": "src/apps/pizza-service",
      "entryFile": "main",
      "sourceRoot": "src/apps/pizza-service/src",
      "compilerOptions": {
        "tsConfigPath": "src/apps/pizza-service/tsconfig.app.json",
        "outDir": "dist/src/apps/pizza-service"
      }
    },
    "promo-code-service": {
      "type": "application",
      "root": "src/apps/promo-code-service",
      "entryFile": "main",
      "sourceRoot": "src/apps/promo-code-service/src",
      "compilerOptions": {
        "tsConfigPath": "src/apps/promo-code-service/tsconfig.app.json", 
        "outDir": "dist/src/apps/promo-code-service"
      }
    },
    "ingredients-service": {
      "type": "application",
      "root": "src/apps/ingredients-service",
      "entryFile": "main",
      "sourceRoot": "src/apps/ingredients-service/src",
      "compilerOptions": {
        "tsConfigPath": "src/apps/ingredients-service/tsconfig.app.json",
        "outDir": "dist/src/apps/ingredients-service"
      }
    },
    "cart-service": {
      "type": "application",
      "root": "src/apps/cart-service",
      "entryFile": "main",
      "sourceRoot": "src/apps/cart-service/src",
      "compilerOptions": {
        "tsConfigPath": "src/apps/cart-service/tsconfig.app.json",
        "outDir": "dist/src/apps/cart-service"
      }
    },
    "order-service": {
      "type": "application",
      "root": "src/apps/order-service",
      "entryFile": "main",
      "sourceRoot": "src/apps/order-service/src",
      "compilerOptions": {
        "tsConfigPath": "src/apps/order-service/tsconfig.app.json",
        "outDir": "dist/src/apps/order-service"
      }
    },
    "notification-service": {
      "type": "application",
      "root": "src/apps/notification-service",
      "entryFile": "main",
      "sourceRoot": "src/apps/notification-service/src",
      "compilerOptions": {
        "tsConfigPath": "src/apps/notification-service/tsconfig.app.json",
        "outDir": "dist/src/apps/notification-service"
      }
    },
    "logger-service": {
      "type": "application",
      "root": "src/apps/logger-service",
      "entryFile": "main",
      "sourceRoot": "src/apps/logger-service/src",
      "compilerOptions": {
        "tsConfigPath": "src/apps/logger-service/tsconfig.app.json",
        "outDir": "dist/src/apps/logger-service"
      }
    }
  }
}